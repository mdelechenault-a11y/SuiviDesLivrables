# Copiez ce fichier en .env et remplissez-le. Ne versionnez jamais le .env.

# --- Base de données (MariaDB fournie par docker-compose) ---
DB_ROOT_PASSWORD=
DB_USER=sdl
DB_PASSWORD=
DB_GROUP_NAME=sdl_groupe
DB_TENANT_PREFIX=sdl_f_

# --- Sessions ---
# 32 caractères minimum, par exemple : openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=10
# Passez à true dès que l'appli est servie en HTTPS (reverse proxy).
COOKIE_SECURE=false
APP_PORT=3000

# --- Connexion Active Directory ---
AUTH_MODE=ldap
# ldaps://dc01.mondomaine.local:636 (recommandé) ou ldap://dc01.mondomaine.local:389
LDAP_URL=
# Compte de service en lecture seule sur l'annuaire
LDAP_BIND_DN=CN=svc-suivi,OU=Services,DC=mondomaine,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=mondomaine,DC=local
LDAP_USER_ATTRIBUTE=sAMAccountName
# Facultatif : réserver l'accès aux membres d'un groupe AD
LDAP_REQUIRED_GROUP=
LDAP_TLS_REJECT_UNAUTHORIZED=true

# --- Premier administrateur (créé si aucun utilisateur n'existe) ---
# En mode ldap : son identifiant Windows. En mode local : ajoutez BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_ADMIN_USERNAME=
